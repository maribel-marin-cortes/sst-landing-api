# --- Django ---
SECRET_KEY=change-me-in-production-please
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# En producción (Render), agrega también el dominio del propio backend:
# CSRF_TRUSTED_ORIGINS=https://sst-landing-api.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Base de datos (Postgres) ---
# Local/docker-compose: se arma con las 5 variables de abajo.
# Producción (Render): si DATABASE_URL viene definida, tiene prioridad sobre
# las POSTGRES_* y se usa tal cual (Render la genera sola al crear el
# servicio de base de datos).
DATABASE_URL=
POSTGRES_DB=sst_landing
POSTGRES_USER=sst_landing
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS: origen del frontend (React/Vite) ---
CORS_ALLOWED_ORIGINS=http://localhost:5175

# --- Email ---
# En desarrollo usa el backend de consola: imprime el correo en los logs del
# contenedor `api`, no requiere credenciales SMTP reales.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# A quién le llega el aviso de nuevo lead (nueva solicitud de cotización / mensaje de contacto)
NOTIFICACIONES_EMAIL=notificaciones@ejemplo.com

# --- Seed de contenido de ejemplo ---
# Si es true, el entrypoint corre `seed_demo_content` automáticamente al iniciar `api`.
SEED_DEMO=true

# --- Superusuario automático (ensure_admin) ---
# Si las 3 están definidas y el usuario no existe todavía, se crea solo en
# cada build/arranque (útil en Render plan free, que no tiene Shell). Déjalas
# vacías para omitirlo -- no falla si faltan.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
